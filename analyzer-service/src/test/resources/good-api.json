{
  "openapi": "3.0.3",
  "info": {
    "title": "Good Sample API",
    "version": "1.0.0"
  },
  "paths": {
    "/users": {
      "get": {
        "operationId": "listUsers",
        "responses": {
          "200": { "description": "Success" },
          "400": { "description": "Bad request" }
        }
      }
    },
    "/users/{userId}": {
      "get": {
        "operationId": "getUserById",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Success" },
          "404": { "description": "Not found" }
        }
      }
    }
  }
}
